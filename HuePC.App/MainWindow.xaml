                                    <Grid>
                                        <StackPanel>
                                            <TextBlock Text="Meşgul ışığı" Style="{StaticResource RowLabel}" />
                                            <TextBlock Text="{Binding BusyLightStatusText}" Style="{StaticResource RowValue}" FontSize="12" Margin="0,3,0,0" />
                                        </StackPanel>
                                        <ui:ToggleSwitch HorizontalAlignment="Right" VerticalAlignment="Center"
                                                         IsChecked="{Binding BusyLightEnabled, Mode=TwoWay}"
                                                         OnContent="Açık" OffContent="Kapalı" />
                                    </Grid>
                                    <TextBlock Text="Mikrofon veya kamera kullanıldığında ampul kırmızı yanar; görüşme bitince önceki durumuna döner."
                                               Style="{StaticResource RowHint}" Margin="0,6,0,0" TextWrapping="Wrap" />

                                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                        <CheckBox Content="Mikrofon" IsChecked="{Binding BusyLightMicrophone, Mode=TwoWay}" Margin="0,0,18,0"
                                                  Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                        <CheckBox Content="Kamera" IsChecked="{Binding BusyLightCamera, Mode=TwoWay}"
                                                  Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                    </StackPanel>

                                    <Border Height="1" Margin="0,16,0,16" Background="{DynamicResource ControlStrokeColorDefaultBrush}" />

                                    <Grid>
                                        <StackPanel>
                                            <TextBlock Text="Sistem olayları" Style="{StaticResource RowLabel}" />
                                            <TextBlock Text="Pil, şarj ve ağ olayları kısa bir yanıp sönmeyle bildirilir." Style="{StaticResource RowHint}" Margin="0,3,0,0" />
                                        </StackPanel>
                                        <ui:ToggleSwitch HorizontalAlignment="Right" VerticalAlignment="Center"
                                                         IsChecked="{Binding SystemEventsEnabled, Mode=TwoWay}"
                                                         OnContent="Açık" OffContent="Kapalı" />
                                    </Grid>

                                    <StackPanel Margin="0,10,0,0">
                                        <CheckBox Content="Pil %20'nin altına düşünce kırmızı yanıp söner" IsChecked="{Binding SystemBatteryAlert, Mode=TwoWay}" Margin="0,0,0,6"
                                                  Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                        <CheckBox Content="Şarja takılınca yeşil yanıp söner" IsChecked="{Binding SystemChargerNotice, Mode=TwoWay}" Margin="0,0,0,6"
                                                  Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                        <CheckBox Content="Ağ bağlantısı kopunca sarı yanıp söner" IsChecked="{Binding SystemNetworkAlert, Mode=TwoWay}"
                                                  Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                    </StackPanel>
                                </StackPanel>
                            </ui:Card>
                            </StackPanel>

                        </Grid>
                    </ScrollViewer>
                </Grid>

                <Grid Visibility="{Binding IsEnvironmentPage, Converter={StaticResource BoolVisibility}}">
                    <Grid.RenderTransform>
                        <TranslateTransform />
                    </Grid.RenderTransform>
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Style.Triggers>
                                <Trigger Property="Visibility" Value="Visible">
                                    <Trigger.EnterActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.25" />
                                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" From="12" To="0" Duration="0:0:0.3">
                                                    <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.EnterActions>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>

                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.32*" />
                                <ColumnDefinition Width="0.68*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                <ui:Card Padding="24">
                                    <StackPanel>
                                        <TextBlock Text="Otomatik ışık" Style="{StaticResource RowLabel}" />
                                        <TextBlock Text="Zamana ve ekrana göre kendiliğinden ayarlanan ışık." Style="{StaticResource RowHint}" Margin="0,4,0,0" />

                                        <Grid Margin="0,16,0,0">
                                            <StackPanel>
                                                <TextBlock Text="Ekran ortamı" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                                <TextBlock Text="{Binding ScreenAmbienceStatusText}" Style="{StaticResource RowValue}" FontSize="12" Margin="0,3,0,0" />
                                            </StackPanel>
                                            <ui:ToggleSwitch HorizontalAlignment="Right" VerticalAlignment="Center"
                                                             IsChecked="{Binding ScreenAmbienceEnabled, Mode=TwoWay}"
                                                             OnContent="Açık" OffContent="Kapalı" />
                                        </Grid>
                                        <TextBlock Text="Ekranın ortalama rengi saniyede birkaç kez ampule yansıtılır; karanlık sahnelerde ampul kısılır."
                                                   Style="{StaticResource RowHint}" Margin="0,6,0,0" TextWrapping="Wrap" />

                                        <Border Height="1" Margin="0,14,0,14" Background="{DynamicResource ControlStrokeColorDefaultBrush}" />

                                        <Grid>
                                            <StackPanel>
                                                <TextBlock Text="Gün ritmi" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                                <TextBlock Text="{Binding CircadianStatusText}" Style="{StaticResource RowValue}" FontSize="12" Margin="0,3,0,0" />
                                            </StackPanel>
                                            <ui:ToggleSwitch HorizontalAlignment="Right" VerticalAlignment="Center"
                                                             IsChecked="{Binding CircadianEnabled, Mode=TwoWay}"
                                                             OnContent="Açık" OffContent="Kapalı" />
                                        </Grid>
                                        <TextBlock Text="Gün içinde ışık serinden sıcağa döner: sabah 4000 K civarı, akşam 2200 K. Parlaklık da akşam saatlerinde azalır."
                                                   Style="{StaticResource RowHint}" Margin="0,6,0,0" TextWrapping="Wrap" />
                                    </StackPanel>
                                </ui:Card>

                                <ui:Card Margin="0,14,0,0" Padding="24">
                                    <StackPanel>
                                        <Grid>
                                            <StackPanel>
                                                <TextBlock Text="Hava durumu" Style="{StaticResource RowLabel}" />
                                                <TextBlock Text="{Binding WeatherStatusText}" Style="{StaticResource RowValue}" FontSize="12" Margin="0,3,0,0" />
                                            </StackPanel>
                                            <ui:ToggleSwitch HorizontalAlignment="Right" VerticalAlignment="Center"
                                                             IsChecked="{Binding WeatherEnabled, Mode=TwoWay}"
                                                             OnContent="Açık" OffContent="Kapalı" />
                                        </Grid>
                                        <TextBlock Text="Sabah saatlerinde hava durumuna göre renk uygulanır: açık hava sıcak, yağmur mavi, kar buz mavisi. Veri Open-Meteo'dan anahtarsız alınır."
                                                   Style="{StaticResource RowHint}" Margin="0,8,0,0" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding SunriseSunsetText}" Style="{StaticResource RowHint}" Margin="0,6,0,0" />

                                        <ItemsControl ItemsSource="{Binding WeatherHours}" Margin="0,12,0,0">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border CornerRadius="8" Padding="9,7" Margin="0,0,8,8" MinWidth="72"
                                                            Background="{DynamicResource ControlFillColorDefaultBrush}"
                                                            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1">
                                                        <StackPanel>
                                                            <TextBlock Text="{Binding TimeText}" FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                                            <TextBlock Text="{Binding TemperatureText}" FontSize="13" FontWeight="SemiBold" Margin="0,3,0,0"
                                                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                                                <Ellipse Width="8" Height="8" Fill="{Binding MoodBrush}" VerticalAlignment="Center" />
                                                                <TextBlock Text="{Binding MoodText}" FontSize="10" Margin="5,0,0,0" VerticalAlignment="Center"
                                                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                                            </StackPanel>
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <TextBlock Text="{Binding WeatherLocationHint}" Style="{StaticResource RowHint}" Margin="0,6,0,0" />
                                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                            <ui:TextBox Text="{Binding WeatherLatitude, UpdateSourceTrigger=PropertyChanged}" Width="110" PlaceholderText="Enlem" />
                                            <ui:TextBox Text="{Binding WeatherLongitude, UpdateSourceTrigger=PropertyChanged}" Width="110" Margin="8,0,0,0" PlaceholderText="Boylam" />
                                            <ui:Button Appearance="Secondary" Content="Şimdi yenile" Margin="8,0,0,0" Command="{Binding RefreshWeatherNowCommand}" />
                                            <ui:Button Appearance="Secondary" Content="Haritadan seç" Margin="8,0,0,0" Command="{Binding OpenMapPickerCommand}" />
                                        </StackPanel>
                                    </StackPanel>
                                </ui:Card>

                                <ui:Card Margin="0,14,0,0" Padding="24">
                                    <StackPanel>
                                        <Grid>
                                            <StackPanel>
                                                <TextBlock Text="Deprem alarmı" Style="{StaticResource RowLabel}" />
                                                <TextBlock Text="{Binding EarthquakeStatusText}" Style="{StaticResource RowValue}" FontSize="12" Margin="0,3,0,0" />
                                            </StackPanel>
                                            <ui:ToggleSwitch HorizontalAlignment="Right" VerticalAlignment="Center"
                                                             IsChecked="{Binding EarthquakeAlertEnabled, Mode=TwoWay}"
                                                             OnContent="Açık" OffContent="Kapalı" />
                                        </Grid>
                                        <TextBlock Text="AFAD (deprem.afad.gov.tr) ve EMSC (seismicportal.eu) resmî servisleri dakikada bir kontrol edilir. Eşiğin üstünde ve seçilen yarıçap içinde yeni bir deprem kaydı yayımlanınca ampul kırmızı yanıp söner; aynı deprem iki kaynakta görünse bile tek alarm verilir. Depremler önceden tahmin edilemez; uyarı, kayıt yayımlandığı anda gelir."
                                                   Style="{StaticResource RowHint}" Margin="0,8,0,0" TextWrapping="Wrap" />

                                        <Grid Margin="0,16,0,0">
                                            <TextBlock Text="En düşük büyüklük" Style="{StaticResource RowHint}" />
                                            <ui:TextBox HorizontalAlignment="Right" Width="84" TextAlignment="Center"
                                                        Text="{Binding EarthquakeMinimumMagnitude, Mode=TwoWay, UpdateSourceTrigger=LostFocus, StringFormat={}{0:0.#}}" />
                                        </Grid>
                                        <Slider Style="{StaticResource FluentSlider}" Margin="0,3,0,0" Minimum="2" Maximum="7" SmallChange="0.1" LargeChange="1"
                                                Value="{Binding EarthquakeMinimumMagnitude, Mode=TwoWay}" />

                                        <Grid Margin="0,10,0,0">
                                            <TextBlock Text="Yarıçap" Style="{StaticResource RowHint}" />
                                            <ui:TextBox HorizontalAlignment="Right" Width="84" TextAlignment="Center"
                                                        Text="{Binding EarthquakeRadiusKm, Mode=TwoWay, UpdateSourceTrigger=LostFocus, StringFormat={}{0:0}}" />
                                        </Grid>
                                        <Slider Style="{StaticResource FluentSlider}" Margin="0,3,0,0" Minimum="50" Maximum="1000" SmallChange="25" LargeChange="100"
                                                Value="{Binding EarthquakeRadiusKm, Mode=TwoWay}" />

                                        <TextBlock Text="{Binding EarthquakeLocationHint}" Style="{StaticResource RowHint}" Margin="0,16,0,0" />
                                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                            <ui:TextBox Text="{Binding EarthquakeLatitude, UpdateSourceTrigger=PropertyChanged}" Width="110" PlaceholderText="Enlem" />
                                            <ui:TextBox Text="{Binding EarthquakeLongitude, UpdateSourceTrigger=PropertyChanged}" Width="110" Margin="8,0,0,0" PlaceholderText="Boylam" />
                                        </StackPanel>

                                        <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                            <ui:Button Appearance="Secondary" Content="Şimdi kontrol et" Command="{Binding CheckEarthquakesNowCommand}" />
                                            <ui:Button Appearance="Secondary" Margin="8,0,0,0" Content="Kırmızı alarmı dene" Command="{Binding TestEarthquakeAlertCommand}" />
                                        </StackPanel>
                                    </StackPanel>
                                </ui:Card>
                            </StackPanel>

                            <controls:ArtworkStage Grid.Column="1" Page="Environment" MinHeight="320" />
                        </Grid>
                    </ScrollViewer>
                </Grid>

                <Grid Visibility="{Binding IsDevicesPage, Converter={StaticResource BoolVisibility}}">
                    <Grid.RenderTransform>
                        <TranslateTransform />
                    </Grid.RenderTransform>
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Style.Triggers>
                                <Trigger Property="Visibility" Value="Visible">
                                    <Trigger.EnterActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.25" />
                                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" From="12" To="0" Duration="0:0:0.3">
                                                    <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.EnterActions>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="0.94*" />
                        <ColumnDefinition Width="1.06*" />
                    </Grid.ColumnDefinitions>

                    <ui:Card Grid.Column="0" Margin="0,0,14,0" VerticalAlignment="Stretch" VerticalContentAlignment="Stretch" Padding="20">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Top">
                                <TextBlock Text="Yakındaki ampuller" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                <TextBlock Text="Bağlanmak istediğiniz ampulü seçin." FontSize="12" Margin="0,5,0,14" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                    <ui:Button Appearance="Primary" Content="Ampul ara" Command="{Binding StartScanCommand}"
                                               Visibility="{Binding IsScanning, Converter={StaticResource NotBoolVisibility}}" />
                                    <ui:Button Appearance="Secondary" Content="Aramayı durdur" Command="{Binding StopScanCommand}"
                                               Visibility="{Binding IsScanning, Converter={StaticResource BoolVisibility}}" />
                                    <TextBlock Text="{Binding ScanStatus}" FontSize="12" VerticalAlignment="Center" Margin="12,0,0,0"
                                               Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                </StackPanel>
                            </StackPanel>

                            <Grid>
                                <ListBox ItemsSource="{Binding Devices}" SelectedItem="{Binding SelectedDevice, Mode=TwoWay}" Background="Transparent" BorderThickness="0"
                                         ItemContainerStyle="{StaticResource DeviceListItem}"
                                         Visibility="{Binding HasDiscoveredDevices, Converter={StaticResource BoolVisibility}}">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="36" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <Border Width="30" Height="30" CornerRadius="8" Background="{DynamicResource ControlFillColorSecondaryBrush}" VerticalAlignment="Center">
                                                    <Path Data="{StaticResource BulbGlassGeometry}" Width="12" Height="14" Stretch="Uniform"
                                                          Fill="{StaticResource BulbFill}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0">
                                                    <TextBlock Text="{Binding DisplayName}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                                    <TextBlock Text="Philips Hue" FontSize="11" Margin="0,3,0,0" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <controls:SignalBars Width="26" Height="14" Rssi="{Binding Info.Rssi}" Margin="0,0,10,0" VerticalAlignment="Center" />
                                                    <TextBlock Text="›" FontSize="16" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                                </StackPanel>
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>

                                <StackPanel Visibility="{Binding HasDiscoveredDevices, Converter={StaticResource NotBoolVisibility}}" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="320">
                                    <Border Width="76" Height="76" CornerRadius="20" Background="{DynamicResource ControlFillColorDefaultBrush}" HorizontalAlignment="Center">
                                        <Path Data="{StaticResource BulbGlassGeometry}" Width="34" Height="40" Stretch="Uniform"
                                              Fill="{StaticResource BulbFill}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <TextBlock Text="Henüz ampul bulunamadı" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,18,0,0"
                                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                    <TextBlock Text="Ampulün açık ve yakın olduğundan emin olun, sonra yeniden arayın." FontSize="12"
                                               TextWrapping="Wrap" TextAlignment="Center" Margin="0,9,0,0" LineHeight="18"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    <ui:Button Appearance="Primary" Margin="0,18,0,0" HorizontalAlignment="Center" Content="Ampul ara"
                                               Command="{Binding StartScanCommand}" />
                                </StackPanel>
                            </Grid>
                        </DockPanel>
                    </ui:Card>

                    <ui:Card Grid.Column="1" Margin="14,0,0,0" Padding="20" VerticalAlignment="Stretch" VerticalContentAlignment="Stretch">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel>
                                <StackPanel Visibility="{Binding HasSelectedDevice, Converter={StaticResource BoolVisibility}}">
                                    <TextBlock Text="Seçili ampul" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                    <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                        <Border Width="52" Height="52" CornerRadius="13" Background="{DynamicResource ControlFillColorDefaultBrush}">
                                            <Path Data="{StaticResource BulbGlassGeometry}" Width="22" Height="26" Stretch="Uniform"
                                                  Fill="{StaticResource BulbFill}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <StackPanel VerticalAlignment="Center" Margin="14,0,0,0">
                                            <TextBlock Text="{Binding SelectedDevice.DisplayName}" FontSize="16" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                            <TextBlock Text="{Binding SelectedConnectionState}" FontSize="12" Margin="0,4,0,0"
                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                        </StackPanel>
                                    </StackPanel>

                                    <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                                        <ui:Button Appearance="Primary" Content="Bağlan" Command="{Binding ConnectSelectedCommand}"
                                                   Visibility="{Binding IsSelectedDeviceConnected, Converter={StaticResource NotBoolVisibility}}" />
                                        <ui:Button Appearance="Secondary" Content="Bağlantıyı kes" Command="{Binding DisconnectSelectedCommand}"
                                                   Visibility="{Binding IsSelectedDeviceConnected, Converter={StaticResource BoolVisibility}}" />
                                        <ui:Button Appearance="Secondary" Margin="8,0,0,0" Content="Kontrol paneline git"
                                                   Command="{Binding NavigateToPageCommand}" CommandParameter="Control"
                                                   Visibility="{Binding IsSelectedDeviceConnected, Converter={StaticResource BoolVisibility}}" />
                                    </StackPanel>

                                    <Border Height="1" Margin="0,18,0,18" Background="{DynamicResource ControlStrokeColorDefaultBrush}" />

                                    <TextBlock Text="Otomatik bağlantı" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                    <TextBlock Text="Bağlandığınız ampul bu bilgisayarda hatırlanır; LUMEN açıldığında yeniden bağlanmayı dener."
                                               FontSize="12" TextWrapping="Wrap" Margin="0,7,0,0" LineHeight="18"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    <TextBlock Text="{Binding SelectedDevice.DisplayName, TargetNullValue=Henüz hatırlanan ampul yok}"
                                               FontSize="12" Margin="0,9,0,0" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                                    <ui:Button Appearance="Secondary" Margin="0,10,0,0" HorizontalAlignment="Left" Content="Otomatik bağlantıdan çıkar"
                                               Command="{Binding ForgetRememberedDeviceCommand}"
                                               Visibility="{Binding IsRememberedDeviceSelected, Converter={StaticResource BoolVisibility}}" />

                                    <Border Height="1" Margin="0,18,0,18" Background="{DynamicResource ControlStrokeColorDefaultBrush}" />

                                    <TextBlock Text="Cihaz bilgileri" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                    <Grid Margin="0,10,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="112" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <TextBlock Text="Model" Style="{StaticResource RowHint}" Margin="0,0,0,6" />
                                        <TextBlock Grid.Column="1" Text="{Binding DeviceModel}" FontSize="12" Margin="0,0,0,6" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                        <TextBlock Grid.Row="1" Text="Yazılım" Style="{StaticResource RowHint}" Margin="0,0,0,6" />
                                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding DeviceSoftwareVersion}" FontSize="12" Margin="0,0,0,6" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                        <TextBlock Grid.Row="2" Text="Üretici" Style="{StaticResource RowHint}" Margin="0,0,0,6" />
                                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding DeviceManufacturer}" FontSize="12" Margin="0,0,0,6" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                        <TextBlock Grid.Row="3" Text="Zigbee adresi" Style="{StaticResource RowHint}" Margin="0,0,0,6" />
                                        <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding DeviceZigbeeAddress}" FontSize="12" FontFamily="Consolas" Margin="0,0,0,6" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                        <TextBlock Grid.Row="4" Text="Sinyal" Style="{StaticResource RowHint}" Margin="0,0,0,6" />
                                        <StackPanel Grid.Row="4" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,6">
                                            <controls:SignalBars Width="26" Height="14" Rssi="{Binding SelectedDevice.Info.Rssi}" VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding SelectedDevice.Info.Rssi, StringFormat={}{0} dBm}" FontSize="12" Margin="8,0,0,0" VerticalAlignment="Center"
                                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                        </StackPanel>
                                        <TextBlock Grid.Row="5" Text="Son görülme" Style="{StaticResource RowHint}" />
                                        <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding SelectedDevice.Info.LastSeenUtc, StringFormat={}{0:HH:mm:ss}, ConverterCulture=tr-TR}"
                                                   FontSize="12" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                    </Grid>

                                    <ui:Button Appearance="Secondary" Margin="0,14,0,0" HorizontalAlignment="Left" Content="Windows eşleştirme ayarlarını aç"
                                               Command="{Binding OpenBluetoothSettingsCommand}" />

                                    <TextBlock Text="Cihaz adı (ampulde)" Style="{StaticResource RowHint}" Margin="0,16,0,0" />
                                    <DockPanel Margin="0,6,0,0">
                                        <ui:Button DockPanel.Dock="Right" Appearance="Secondary" Margin="8,0,0,0" Content="Kaydet" Command="{Binding SaveDeviceNameCommand}" />
                                        <ui:TextBox Text="{Binding DeviceNameInput, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Ampulün adı" />
                                    </DockPanel>

                                    <TextBlock Text="Yerel ad (yalnızca bu bilgisayarda)" Style="{StaticResource RowHint}" Margin="0,14,0,0" />
                                    <DockPanel Margin="0,6,0,0">
                                        <ui:Button DockPanel.Dock="Right" Appearance="Secondary" Margin="8,0,0,0" Content="Kaydet" Command="{Binding SaveAliasCommand}" />
                                        <ui:TextBox Text="{Binding DeviceAliasInput, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Örn. Çalışma odası" />
                                    </DockPanel>

                                    <TextBlock Text="Açılış davranışı" Style="{StaticResource RowHint}" Margin="0,16,0,0" />
                                    <StackPanel Margin="0,6,0,0">
                                        <RadioButton GroupName="PowerOnBehaviour" Content="Her zaman aç" FontSize="12"
                                                     Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                                     IsChecked="{Binding IsBehaviourAlwaysOn, Mode=TwoWay}" Margin="0,2,0,2" />
                                        <RadioButton GroupName="PowerOnBehaviour" Content="Son parlaklık ve renk" FontSize="12"
                                                     Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                                     IsChecked="{Binding IsBehaviourLastColour, Mode=TwoWay}" Margin="0,2,0,2" />
                                        <RadioButton GroupName="PowerOnBehaviour" Content="Son durumu koru" FontSize="12"
                                                     Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                                     IsChecked="{Binding IsBehaviourLastState, Mode=TwoWay}" Margin="0,2,0,2" />
                                    </StackPanel>
                                    <TextBlock Text="Elektrik kesintisinden sonra ampulün nasıl davranacağını belirler." Style="{StaticResource RowHint}" Margin="0,6,0,0" TextWrapping="Wrap" />
                                </StackPanel>

                                <StackPanel Visibility="{Binding HasSelectedDevice, Converter={StaticResource NotBoolVisibility}}" HorizontalAlignment="Center" Margin="0,4,0,0">
                                    <controls:ArtworkStage Page="Devices" Width="320" Height="250" Margin="0,0,0,18" />
                                    <TextBlock Text="Bir ampul seçin" FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Center"
                                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                    <TextBlock Text="Bulunan ampuller burada görünecek." FontSize="11" Margin="0,6,0,0"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                </StackPanel>

                                <Border Height="1" Margin="0,18,0,18" Background="{DynamicResource ControlStrokeColorDefaultBrush}" />

                                <TextBlock Text="Windows eşleştirmesi" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                <TextBlock Text="Ampulün ışık kontrolü şifreli bağ ister. Windows ile bir kez eşleştirilmezse komutlar reddedilir. Ampul açılıştan sonraki yaklaşık 30 dakika eşleştirmeye izin verir; gerekirse ampulü kapatıp açın."
                                           FontSize="11" TextWrapping="Wrap" Margin="0,6,0,0" LineHeight="16"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

                                <Border Height="1" Margin="0,18,0,18" Background="{DynamicResource ControlStrokeColorDefaultBrush}" />

                                <TextBlock Text="Gizlilik" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                <TextBlock Text="LUMEN hesap veya bulut kullanmaz. Ampul adı ve bağlantı kayıtları yalnızca bu bilgisayarda tutulur."
                                           FontSize="11" TextWrapping="Wrap" Margin="0,6,0,0" LineHeight="16"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                        </ScrollViewer>
                    </ui:Card>
                </Grid>

                <Grid Visibility="{Binding IsSchedulesPage, Converter={StaticResource BoolVisibility}}">
                    <Grid.RenderTransform>
                        <TranslateTransform />
                    </Grid.RenderTransform>
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Style.Triggers>
                                <Trigger Property="Visibility" Value="Visible">
                                    <Trigger.EnterActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.25" />
                                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" From="12" To="0" Duration="0:0:0.3">
                                                    <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.EnterActions>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="0.9*" />
                        <ColumnDefinition Width="1.1*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <ui:Card Grid.Row="0" Grid.ColumnSpan="2" Margin="0,0,0,14" Padding="20">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0">
                                <TextBlock Text="Haftalık görünüm" Style="{StaticResource RowLabel}" />
                                <TextBlock Text="{Binding NextScheduleText}" HorizontalAlignment="Right" Style="{StaticResource RowValue}" TextTrimming="CharacterEllipsis" />
                            </Grid>
                            <TextBlock Grid.Row="1" Text="Blokları sürükleyin: yukarı/aşağı saat, yana sürükleme gün değiştirir." Style="{StaticResource RowHint}" Margin="0,4,0,0" />
                            <controls:WeekTimeline Grid.Row="2" x:Name="WeekTimeline" Height="178" Margin="0,10,0,0"
                                                   Items="{Binding Schedules}" ItemMoved="OnTimelineItemMoved" />
                            <TextBlock Grid.Row="1" Text="{Binding ScheduleConflictText}" Style="{StaticResource RowHint}" Margin="0,4,0,0" HorizontalAlignment="Right"
                                       Foreground="#FFC400" Visibility="{Binding HasScheduleConflict, Converter={StaticResource BoolVisibility}}" />
                        </Grid>
                    </ui:Card>

                    <Grid Grid.Row="1" Grid.Column="0" Margin="0,0,14,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <ui:Card Grid.Row="0" Padding="20" VerticalAlignment="Stretch" VerticalContentAlignment="Stretch">
                        <DockPanel>
                            <Grid DockPanel.Dock="Top">
                                <StackPanel>
                                    <TextBlock Text="Alarmlar" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                    <TextBlock Text="LUMEN açıkken çalışır; tepside de sürer."
                                               FontSize="12" TextWrapping="Wrap" Margin="0,5,0,0"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                                <ui:Button Appearance="Primary" Content="Yeni alarm" HorizontalAlignment="Right" VerticalAlignment="Top"
                                           Command="{Binding AddScheduleCommand}" />
                            </Grid>

                            <Grid Margin="0,16,0,0">
                                <ListBox ItemsSource="{Binding Schedules}" SelectedItem="{Binding SelectedSchedule, Mode=TwoWay}"
                                         Background="Transparent" BorderThickness="0" ItemContainerStyle="{StaticResource DeviceListItem}"
                                         Visibility="{Binding HasSchedules, Converter={StaticResource BoolVisibility}}">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock Text="{Binding DisplayTitle}" FontSize="13" FontWeight="SemiBold"
                                                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                                    <TextBlock FontSize="11" Margin="0,4,0,0" Foreground="{DynamicResource TextFillColorTertiaryBrush}">
                                                        <Run Text="{Binding DaysText, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding ActionText, Mode=OneWay}" />
                                                    </TextBlock>
                                                </StackPanel>
                                                <Border Grid.Column="1" CornerRadius="9" Padding="9,5" VerticalAlignment="Center"
                                                        Background="{DynamicResource ControlFillColorSecondaryBrush}">
                                                    <TextBlock Text="{Binding EnabledText}" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                                </Border>
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>

                                <StackPanel Visibility="{Binding HasSchedules, Converter={StaticResource NotBoolVisibility}}"
                                            HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,16,0,0" MaxWidth="300">
                                    <TextBlock Text="Henüz alarm yok" FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Center"
                                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                    <TextBlock Text="Yeni alarm ekleyip saati, günleri ve ampulün nasıl açılacağını belirleyin."
                                               FontSize="12" TextWrapping="Wrap" TextAlignment="Center" Margin="0,8,0,0" LineHeight="17"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                            </Grid>
                        </DockPanel>
                        </ui:Card>

                        <ui:Card Grid.Row="1" Margin="0,14,0,0" Padding="20">
                            <StackPanel>
                                <Grid>
                                    <TextBlock Text="Pomodoro" Style="{StaticResource RowLabel}" />
                                    <TextBlock Text="{Binding PomodoroCycleText}" HorizontalAlignment="Right" Style="{StaticResource RowValue}" />
                                </Grid>
                                <TextBlock Text="Odakta ampul beyaz, molada yeşil yanar. Tepsi menüsünden de başlatabilirsiniz."
                                           Style="{StaticResource RowHint}" Margin="0,4,0,0" TextWrapping="Wrap" LineHeight="15" />

                                <Grid Margin="0,10,0,0">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding PomodoroTimeText}" FontSize="30" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                        <TextBlock Text="{Binding PomodoroPhaseText}" FontSize="12" Margin="10,0,0,2" VerticalAlignment="Bottom"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <ui:Button Appearance="Primary" Content="Başlat" Command="{Binding TogglePomodoroCommand}"
                                                   Visibility="{Binding IsPomodoroRunning, Converter={StaticResource NotBoolVisibility}}" />
                                        <ui:Button Appearance="Secondary" Content="Durdur" Command="{Binding TogglePomodoroCommand}"
                                                   Visibility="{Binding IsPomodoroRunning, Converter={StaticResource BoolVisibility}}" />
                                    </StackPanel>
                                </Grid>

                                <Grid Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <Grid>
                                            <TextBlock Text="Odak süresi" Style="{StaticResource RowHint}" />
                                            <TextBlock Text="{Binding PomodoroWorkMinutes, StringFormat={}{0:0} dk}" HorizontalAlignment="Right" Style="{StaticResource RowValue}" />
                                        </Grid>
                                        <Slider Style="{StaticResource FluentSlider}" Margin="0,3,0,0" Minimum="5" Maximum="60"
                                                Value="{Binding PomodoroWorkMinutes, Mode=TwoWay}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="12,0,0,0">
                                        <Grid>
                                            <TextBlock Text="Mola süresi" Style="{StaticResource RowHint}" />
                                            <TextBlock Text="{Binding PomodoroBreakMinutes, StringFormat={}{0:0} dk}" HorizontalAlignment="Right" Style="{StaticResource RowValue}" />
                                        </Grid>
                                        <Slider Style="{StaticResource FluentSlider}" Margin="0,3,0,0" Minimum="1" Maximum="30"
                                                Value="{Binding PomodoroBreakMinutes, Mode=TwoWay}" />
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </ui:Card>
                    </Grid>

                    <ui:Card Grid.Row="1" Grid.Column="1" Margin="14,0,0,0" Padding="20" VerticalAlignment="Stretch" VerticalContentAlignment="Stretch">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <Grid>
                                <StackPanel Visibility="{Binding IsScheduleSelected, Converter={StaticResource BoolVisibility}}">
                                    <TextBlock Text="Alarm düzenle" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />

                                    <TextBlock Text="Ad" Style="{StaticResource RowHint}" Margin="0,14,0,0" />
                                    <ui:TextBox Text="{Binding SelectedSchedule.Name, UpdateSourceTrigger=PropertyChanged}"
                                                Margin="0,6,0,0" PlaceholderText="Örn. Sabah" />

                                    <TextBlock Text="Saat (SS:DD)" Style="{StaticResource RowHint}" Margin="0,14,0,0" />
                                    <ui:TextBox Text="{Binding SelectedSchedule.TimeText, UpdateSourceTrigger=PropertyChanged}"
                                                Margin="0,6,0,0" Width="120" HorizontalAlignment="Left" PlaceholderText="20:30" />

                                    <TextBlock Text="Günler" Style="{StaticResource RowHint}" Margin="0,14,0,0" />
                                    <WrapPanel Margin="0,6,0,0">
                                        <CheckBox Content="Pzt" IsChecked="{Binding SelectedSchedule.Monday, Mode=TwoWay}" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,0,12,6" />
                                        <CheckBox Content="Sal" IsChecked="{Binding SelectedSchedule.Tuesday, Mode=TwoWay}" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,0,12,6" />
                                        <CheckBox Content="Çar" IsChecked="{Binding SelectedSchedule.Wednesday, Mode=TwoWay}" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,0,12,6" />
                                        <CheckBox Content="Per" IsChecked="{Binding SelectedSchedule.Thursday, Mode=TwoWay}" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,0,12,6" />
                                        <CheckBox Content="Cum" IsChecked="{Binding SelectedSchedule.Friday, Mode=TwoWay}" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,0,12,6" />
                                        <CheckBox Content="Cmt" IsChecked="{Binding SelectedSchedule.Saturday, Mode=TwoWay}" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,0,12,6" />
                                        <CheckBox Content="Paz" IsChecked="{Binding SelectedSchedule.Sunday, Mode=TwoWay}" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,0,12,6" />
                                    </WrapPanel>

                                    <TextBlock Text="Eylem" Style="{StaticResource RowHint}" Margin="0,10,0,0" />
                                    <StackPanel Margin="0,6,0,0">
                                        <RadioButton GroupName="ScheduleAction" Content="Seçtiğim durumla aç" FontSize="12"
                                                     Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                                     IsChecked="{Binding SelectedSchedule.TurnOn, Mode=TwoWay}" />
                                        <RadioButton GroupName="ScheduleAction" Content="Kapat" FontSize="12" Margin="0,4,0,0"
                                                     Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                                     IsChecked="{Binding SelectedSchedule.TurnOff, Mode=TwoWay}" />
                                    </StackPanel>

                                    <Border CornerRadius="8" Padding="14" Margin="0,12,0,0"
                                            Background="{DynamicResource ControlFillColorDefaultBrush}"
                                            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1"
                                            Visibility="{Binding SelectedSchedule.TurnOn, Converter={StaticResource BoolVisibility}}">
                                        <StackPanel>
                                            <TextBlock Text="{Binding SelectedSchedule.StateSummary}" FontSize="12"
                                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                            <TextBlock Text="Ampulü istediğiniz renk ve parlaklığa ayarlayın, sonra bu düğmeye basın."
                                                       FontSize="11" TextWrapping="Wrap" Margin="0,5,0,0" LineHeight="16"
                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                            <ui:Button Appearance="Secondary" Content="Ampulün mevcut durumunu al" Margin="0,10,0,0" HorizontalAlignment="Left"
                                                       Command="{Binding CaptureCurrentStateCommand}" />

                                            <TextBlock Text="Gün doğumu (yumuşak uyanış)" Style="{StaticResource RowHint}" Margin="0,14,0,0" />
                                            <Grid Margin="0,4,0,0">
                                                <TextBlock Text="Alarmdan önce kısıktan başlayıp yavaşça parlar; 0 = kapalı" Style="{StaticResource RowHint}" />
                                                <TextBlock Text="{Binding SelectedSchedule.WakeUpRampText}" HorizontalAlignment="Right" Style="{StaticResource RowValue}" />
                                            </Grid>
                                            <Slider Style="{StaticResource FluentSlider}" Margin="0,3,0,0" Minimum="0" Maximum="30"
                                                    Value="{Binding SelectedSchedule.WakeUpRampMinutes, Mode=TwoWay}" />
                                        </StackPanel>
                                    </Border>

                                    <ui:ToggleSwitch Margin="0,16,0,0" HorizontalAlignment="Left"
                                                     IsChecked="{Binding SelectedSchedule.Enabled, Mode=TwoWay}"
                                                     OnContent="Etkin" OffContent="Kapalı" />

                                    <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
                                        <ui:Button Appearance="Primary" Content="Kaydet" Command="{Binding SaveScheduleCommand}" />
                                        <ui:Button Appearance="Secondary" Margin="8,0,0,0" Content="Sil"
                                                   Command="{Binding DeleteScheduleCommand}" CommandParameter="{Binding SelectedSchedule}" />
                                    </StackPanel>
                                </StackPanel>

                                <StackPanel Visibility="{Binding IsScheduleSelected, Converter={StaticResource NotBoolVisibility}}"
                                            HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="420">
                                    <controls:ArtworkStage Page="Schedules" Height="300" Margin="0,0,0,18" />
                                    <TextBlock Text="Düzenlemek veya yeni alarm oluşturmak için soldan seçin"
                                               FontSize="13" HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                            </Grid>
                        </ScrollViewer>
                    </ui:Card>
                </Grid>
            </Grid>

            <DockPanel Grid.Row="2" Margin="0,12,0,0">
                <TextBlock Text="{Binding StatusMessage}" FontSize="12" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                           Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                <TextBlock DockPanel.Dock="Right" Text="LUMEN · WINDOWS" FontSize="9" FontWeight="SemiBold" Margin="18,0,0,0" VerticalAlignment="Center"
                           Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
            </DockPanel>
        </Grid>

        <Grid Grid.ColumnSpan="2" Panel.ZIndex="100" Background="#D90B1014"
              Visibility="{Binding IsFirstRunVisible, Converter={StaticResource BoolVisibility}}">
            <ui:Card Width="640" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="28">
                <StackPanel>
                    <Grid>
                        <TextBlock Text="LUMEN kurulumu" Style="{StaticResource RowLabel}" FontSize="16" />
                        <TextBlock HorizontalAlignment="Right" Style="{StaticResource RowValue}"
                                   Text="{Binding FirstRunStep, StringFormat=Adım {0}/4}" />
                    </Grid>

                    <TextBlock Text="{Binding FirstRunStepTitle}" FontSize="22" FontWeight="SemiBold" Margin="0,20,0,0"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                    <TextBlock Text="{Binding FirstRunStepHint}" Style="{StaticResource RowHint}" Margin="0,8,0,0" TextWrapping="Wrap" />

                    <StackPanel Visibility="{Binding IsFirstRunStep2, Converter={StaticResource BoolVisibility}}" Margin="0,18,0,0">
                        <ListBox ItemsSource="{Binding Devices}" SelectedItem="{Binding SelectedDevice, Mode=TwoWay}" MaxHeight="150"
                                 Background="Transparent" BorderThickness="0" ItemContainerStyle="{StaticResource DeviceListItem}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding DisplayName}" FontSize="13" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                        <controls:SignalBars Grid.Column="1" Width="26" Height="14" Rssi="{Binding Info.Rssi}" VerticalAlignment="Center" />
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <ui:Button Appearance="Secondary" Content="Ampul ara" Command="{Binding StartScanCommand}"
                                       Visibility="{Binding IsScanning, Converter={StaticResource NotBoolVisibility}}" />
                            <ui:Button Appearance="Secondary" Content="Aramayı durdur" Command="{Binding StopScanCommand}"
                                       Visibility="{Binding IsScanning, Converter={StaticResource BoolVisibility}}" />
                            <ui:Button Appearance="Primary" Margin="8,0,0,0" Content="Bağlan" Command="{Binding ConnectSelectedCommand}" />
                            <TextBlock Text="{Binding SelectedConnectionState}" Style="{StaticResource RowHint}" VerticalAlignment="Center" Margin="12,0,0,0" />
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Visibility="{Binding IsFirstRunStep3, Converter={StaticResource BoolVisibility}}" Margin="0,18,0,0">
                        <ui:Button Appearance="Primary" HorizontalAlignment="Left" Content="Bildirim iznini ver"
                                   Command="{Binding AllowFirstRunNotificationsCommand}" />
                        <TextBlock Text="{Binding NotificationAccessHint}" Style="{StaticResource RowHint}" Margin="0,10,0,0" TextWrapping="Wrap" />
                    </StackPanel>

                    <StackPanel Visibility="{Binding IsFirstRunStep4, Converter={StaticResource BoolVisibility}}" Margin="0,18,0,0">
                        <CheckBox Content="Bildirim gelince ampul yanıp sönsün" IsChecked="{Binding FirstRunNotificationChoice, Mode=TwoWay}"
                                  Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,0,0,10" />
                        <CheckBox Content="Meşgul ışığı: mikrofon veya kamera kullanımda kırmızı yansın" IsChecked="{Binding FirstRunBusyLightChoice, Mode=TwoWay}"
                                  Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,0,0,10" />
                        <CheckBox Content="Gün ritmi: sabah serin, akşam sıcak beyaz" IsChecked="{Binding FirstRunCircadianChoice, Mode=TwoWay}"
                                  Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,0,0,10" />
                        <CheckBox Content="Deprem alarmı: AFAD ve EMSC kayıtlarını izle" IsChecked="{Binding FirstRunEarthquakeChoice, Mode=TwoWay}"
                                  Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0">
                        <ui:Button Appearance="Secondary" Content="Atla" Command="{Binding SkipFirstRunCommand}" />
                        <ui:Button Appearance="Secondary" Margin="8,0,0,0" Content="Geri" Command="{Binding PreviousFirstRunStepCommand}"
                                   Visibility="{Binding CanGoBackFirstRun, Converter={StaticResource BoolVisibility}}" />
                        <ui:Button Appearance="Primary" Margin="8,0,0,0" Content="İleri" Command="{Binding NextFirstRunStepCommand}"
                                   Visibility="{Binding IsFirstRunStep4, Converter={StaticResource NotBoolVisibility}}" />
                        <ui:Button Appearance="Primary" Margin="8,0,0,0" Content="Bitir" Command="{Binding FinishFirstRunCommand}"
                                   Visibility="{Binding IsFirstRunStep4, Converter={StaticResource BoolVisibility}}" />
                    </StackPanel>
                </StackPanel>
            </ui:Card>
        </Grid>
    </Grid>
    </Grid>
</ui:FluentWindow>
