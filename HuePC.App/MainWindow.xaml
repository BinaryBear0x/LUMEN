<ui:FluentWindow x:Class="HuePC.App.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:local="clr-namespace:HuePC.App"
                 xmlns:controls="clr-namespace:HuePC.App.Controls"
                 Title="LUMEN" Icon="Assets/lumen.ico" Width="1360" Height="880" MinWidth="1080" MinHeight="720"
                 WindowStartupLocation="CenterScreen"
                 ExtendsContentIntoTitleBar="True" WindowBackdropType="Mica" WindowCornerPreference="Round"
                 FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13"
                 UseLayoutRounding="True" SnapsToDevicePixels="True" TextOptions.TextFormattingMode="Display">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolVisibility" />
        <local:InverseBooleanToVisibilityConverter x:Key="NotBoolVisibility" />

        <SolidColorBrush x:Key="BulbFill" Color="#3A424A" />
        <SolidColorBrush x:Key="BulbGlow" Color="#00FFA64B" />

        <PathGeometry x:Key="BulbGlassGeometry"
                      Figures="M110,18 C158,18 190,52 190,100 C190,136 168,158 152,178 C144,188 140,198 140,208 L80,208 C80,198 76,188 68,178 C52,158 30,136 30,100 C30,52 62,18 110,18 Z" />

        <Style x:Key="RowLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        </Style>

        <Style x:Key="RowValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        </Style>

        <Style x:Key="RowHint" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="LineHeight" Value="17" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
        </Style>

        <Style x:Key="NavItem" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="Margin" Value="0,1,0,0" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border x:Name="Root" CornerRadius="9" Background="{TemplateBinding Background}" />
                            <Border x:Name="HoverSurface" CornerRadius="9" Background="{DynamicResource ControlFillColorSecondaryBrush}" Opacity="0" />
                            <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Left" VerticalAlignment="Center" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="HoverSurface" Storyboard.TargetProperty="Opacity"
                                                             To="0.65" Duration="0:0:0.18">
                                                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="HoverSurface" Storyboard.TargetProperty="Opacity"
                                                             To="0" Duration="0:0:0.22">
                                                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Opacity" Value="0.8" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="NavItemOverview" TargetType="Button" BasedOn="{StaticResource NavItem}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsOverviewPage}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
                    <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="NavItemDiagnostics" TargetType="Button" BasedOn="{StaticResource NavItem}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsDiagnosticsPage}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
                    <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="FavoriteStar" TargetType="ToggleButton">
            <Setter Property="Content" Value="☆" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="2,0,4,0" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border Background="Transparent" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsChecked" Value="True">
                    <Setter Property="Content" Value="★" />
                    <Setter Property="Foreground" Value="#FFD65B" />
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="#FFD65B" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="NavItemControl" TargetType="Button" BasedOn="{StaticResource NavItem}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsControlPage}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
                    <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="NavItemDevices" TargetType="Button" BasedOn="{StaticResource NavItem}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsDevicesPage}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
                    <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="NavItemSchedules" TargetType="Button" BasedOn="{StaticResource NavItem}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSchedulesPage}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
                    <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="NavItemEffects" TargetType="Button" BasedOn="{StaticResource NavItem}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsEffectsPage}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
                    <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="NavItemProfiles" TargetType="Button" BasedOn="{StaticResource NavItem}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsProfilesPage}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
                    <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="NavItemMusic" TargetType="Button" BasedOn="{StaticResource NavItem}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsMusicPage}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
                    <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="NavItemNotifications" TargetType="Button" BasedOn="{StaticResource NavItem}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsNotificationsPage}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
                    <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="NavItemEnvironment" TargetType="Button" BasedOn="{StaticResource NavItem}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsEnvironmentPage}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
                    <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="FluentSlider" TargetType="Slider">
            <Setter Property="Height" Value="32" />
            <Setter Property="IsMoveToPointEnabled" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid VerticalAlignment="Center">
                            <Border Height="4" CornerRadius="2" Background="{DynamicResource ControlFillColorSecondaryBrush}" />
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="Slider.DecreaseLarge" Focusable="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Height="4" CornerRadius="2" Background="{DynamicResource AccentFillColorDefaultBrush}" />
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="Slider.IncreaseLarge" Focusable="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton"><Border Background="Transparent" /></ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Width="18" Height="18" Cursor="Hand">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Grid>
                                                    <Ellipse Fill="{DynamicResource ControlFillColorDefaultBrush}" Stroke="{DynamicResource ControlStrokeColorDefaultBrush}" StrokeThickness="1" />
                                                    <Ellipse Width="8" Height="8" Fill="{DynamicResource AccentFillColorDefaultBrush}" />
                                                </Grid>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TemperatureSlider" TargetType="Slider" BasedOn="{StaticResource FluentSlider}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid VerticalAlignment="Center">
                            <Border Height="4" CornerRadius="2">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Color="#FFB46B" Offset="0" />
                                        <GradientStop Color="#FFF3D6" Offset="0.5" />
                                        <GradientStop Color="#CFE4FF" Offset="1" />
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="Slider.DecreaseLarge" Focusable="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton"><Border Background="Transparent" /></ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="Slider.IncreaseLarge" Focusable="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton"><Border Background="Transparent" /></ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Width="18" Height="18" Cursor="Hand">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Grid>
                                                    <Ellipse Fill="{DynamicResource ControlFillColorDefaultBrush}" Stroke="{DynamicResource ControlStrokeColorDefaultBrush}" StrokeThickness="1" />
                                                    <Ellipse Width="8" Height="8" Fill="#FFFFFF" />
                                                </Grid>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DeviceListItem" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,0,0,6" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="ItemBorder" CornerRadius="6" Padding="10"
                                Background="{DynamicResource ControlFillColorDefaultBrush}"
                                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="EffectChip" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="0,0,8,8" />
            <Setter Property="Padding" Value="13,7" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Background" Value="{DynamicResource ControlFillColorDefaultBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root" CornerRadius="15" Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Opacity" Value="0.8" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="EffectChipActive" TargetType="Button" BasedOn="{StaticResource EffectChip}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsActive}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                    <Setter Property="Foreground" Value="#FFFFFF" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ProfileChip" TargetType="Button" BasedOn="{StaticResource EffectChip}">
            <Setter Property="Padding" Value="10,6" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsRunning}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
                    <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="LUMEN" ShowMinimize="True" ShowMaximize="True" ShowClose="True" />

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="252" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{DynamicResource ControlFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="0,0,1,0">
            <Grid Margin="14,22,14,16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Orientation="Horizontal" Margin="2,0,0,14">
                    <Grid Width="84" Height="108">
                        <Ellipse Width="58" Height="11" VerticalAlignment="Bottom" Margin="0,0,0,3" Fill="#4328D85B" />
                        <Image Source="Assets/lumen-servo-skull-splash.png" Width="80" Height="104" Stretch="Uniform" RenderOptions.BitmapScalingMode="NearestNeighbor">
                            <Image.RenderTransform><TranslateTransform /></Image.RenderTransform>
                            <Image.Triggers>
                                <EventTrigger RoutedEvent="Loaded">
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                                             From="-3" To="3" Duration="0:0:2.5" AutoReverse="True" RepeatBehavior="Forever">
                                                <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut" /></DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                            </Image.Triggers>
                        </Image>
                    </Grid>
                    <StackPanel VerticalAlignment="Center" Margin="8,0,0,0">
                        <TextBlock Text="LUMEN" FontSize="19" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                        <TextBlock Text="Işığına hükmet" FontSize="10" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Margin="0,3,0,0" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Row="1">
                    <Button Style="{StaticResource NavItemOverview}" Command="{Binding NavigateToPageCommand}" CommandParameter="Overview">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Home24" FontSize="16"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                            <TextBlock Text="Genel bakış" Margin="10,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource NavItemControl}" Command="{Binding NavigateToPageCommand}" CommandParameter="Control">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Home24" FontSize="16"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                            <TextBlock Text="Kontrol" Margin="10,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource NavItemDevices}" Command="{Binding NavigateToPageCommand}" CommandParameter="Devices">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Bluetooth24" FontSize="16"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                            <TextBlock Text="Ampuller" Margin="10,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource NavItemSchedules}" Command="{Binding NavigateToPageCommand}" CommandParameter="Schedules">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Calendar24" FontSize="16"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                            <TextBlock Text="Zamanlayıcı" Margin="10,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource NavItemEffects}" Command="{Binding NavigateToPageCommand}" CommandParameter="Effects">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Flash24" FontSize="16"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                            <TextBlock Text="Efektler" Margin="10,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource NavItemProfiles}" Command="{Binding NavigateToPageCommand}" CommandParameter="Profiles">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="PaintBrush24" FontSize="16"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                            <TextBlock Text="Profiller" Margin="10,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource NavItemMusic}" Command="{Binding NavigateToPageCommand}" CommandParameter="Music">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="MusicNote224" FontSize="16"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                            <TextBlock Text="Müzik" Margin="10,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource NavItemNotifications}" Command="{Binding NavigateToPageCommand}" CommandParameter="Notifications">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="AlertBadge24" FontSize="16"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                            <TextBlock Text="Bildirimler" Margin="10,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource NavItemEnvironment}" Command="{Binding NavigateToPageCommand}" CommandParameter="Environment">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="WeatherSunny24" FontSize="16"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                            <TextBlock Text="Ortam" Margin="10,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource NavItemDiagnostics}" Command="{Binding NavigateToPageCommand}" CommandParameter="Diagnostics">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Pulse24" FontSize="16"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                            <TextBlock Text="Tanılama" Margin="10,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <StackPanel Grid.Row="3">
                    <Border CornerRadius="8" Padding="12"
                            Background="{DynamicResource ControlFillColorDefaultBrush}"
                            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="7" Height="7" Fill="{Binding ConnectionDotBrush}" VerticalAlignment="Center">
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsSelectedDeviceConnected}" Value="True">
                                                    <DataTrigger.EnterActions>
                                                        <BeginStoryboard x:Name="DotPulse">
                                                            <Storyboard>
                                                                <DoubleAnimation Storyboard.TargetProperty="Opacity" From="1" To="0.35" Duration="0:0:1.4" AutoReverse="True" RepeatBehavior="Forever" />
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </DataTrigger.EnterActions>
                                                    <DataTrigger.ExitActions>
                                                        <StopStoryboard BeginStoryboardName="DotPulse" />
                                                    </DataTrigger.ExitActions>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>
                                <TextBlock Text="{Binding SelectedConnectionState}" FontSize="11" Margin="8,0,0,0" VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                            <TextBlock Text="{Binding SelectedPowerState}" FontSize="11" Margin="0,6,0,0"
                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                        </StackPanel>
                    </Border>
                    <TextBlock Text="Yerel · bulut yok" FontSize="10" Margin="2,10,0,0"
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Column="1" Margin="26,18,26,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,18" Height="68">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding PageTitle}" FontSize="27" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                    <TextBlock Text="{Binding PageSubtitle}" FontSize="13" Margin="0,5,0,0" TextTrimming="CharacterEllipsis"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                </StackPanel>
                <Border Height="1" VerticalAlignment="Bottom" Background="{DynamicResource ControlStrokeColorDefaultBrush}" />
            </Grid>

            <Grid Grid.Row="1">
                <Grid Visibility="{Binding IsOverviewPage, Converter={StaticResource BoolVisibility}}">
                    <Grid.RenderTransform>
                        <TranslateTransform />
                    </Grid.RenderTransform>
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Style.Triggers>
                                <Trigger Property="Visibility" Value="Visible">
                                    <Trigger.EnterActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.25" />
                                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" From="12" To="0" Duration="0:0:0.3">
                                                    <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.EnterActions>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.05*" />
                        <ColumnDefinition Width="0.95*" />
                    </Grid.ColumnDefinitions>

                    <ui:Card Grid.Column="0" Margin="0,0,14,0" Padding="0" VerticalAlignment="Stretch" VerticalContentAlignment="Stretch">
                        <Grid ClipToBounds="True">
                            <controls:BulbPreview Width="300" Height="330" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                  PreviewColor="{Binding WheelColor}" Brightness="{Binding BrightnessPercent}"
                                                  IsOn="{Binding IsLightOn}" IsColorMode="{Binding IsColorMode}"
                                                  ColorTemperature="{Binding ColorTemperatureMired}" Margin="16,6,16,40" />
                            <StackPanel VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,50">
                                <TextBlock Text="{Binding SelectedDevice.DisplayName, TargetNullValue=Henüz ampul bağlı değil}" HorizontalAlignment="Center"
                                           FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                <TextBlock Text="{Binding SelectedConnectionState}" HorizontalAlignment="Center" FontSize="12" Margin="0,4,0,0"
                                           Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,14">
                                <ui:ToggleSwitch IsChecked="{Binding IsLightOn, Mode=TwoWay}" OnContent="Açık" OffContent="Kapalı" />
                                <ui:Button Appearance="Secondary" Margin="12,0,0,0" Content="Efektler" Command="{Binding NavigateToPageCommand}" CommandParameter="Effects" />
                                <ui:Button Appearance="Secondary" Margin="8,0,0,0" Content="Müzik" Command="{Binding NavigateToPageCommand}" CommandParameter="Music" />
                            </StackPanel>
                        </Grid>
                    </ui:Card>

                    <Grid Grid.Column="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <ui:Card Grid.Row="0" Margin="0,0,0,14" Padding="24" VerticalAlignment="Stretch" VerticalContentAlignment="Stretch">
                            <StackPanel>
                                <TextBlock Text="Bugün" Style="{StaticResource RowLabel}" />
                                <Grid Margin="0,14,0,0">
                                    <TextBlock Text="Sonraki alarm" Style="{StaticResource RowHint}" />
                                    <TextBlock Text="{Binding NextScheduleText}" HorizontalAlignment="Right" Style="{StaticResource RowValue}" TextTrimming="CharacterEllipsis" />
                                </Grid>
                                <Grid Margin="0,10,0,0">
                                    <TextBlock Text="Pomodoro" Style="{StaticResource RowHint}" />
                                    <TextBlock Text="{Binding PomodoroSummary}" HorizontalAlignment="Right" Style="{StaticResource RowValue}" />
                                </Grid>
                                <Grid Margin="0,10,0,0">
                                    <TextBlock Text="Hava durumu" Style="{StaticResource RowHint}" />
                                    <TextBlock Text="{Binding WeatherStatusText}" HorizontalAlignment="Right" Style="{StaticResource RowValue}" />
                                </Grid>
                                <TextBlock Text="{Binding SunriseSunsetText}" Style="{StaticResource RowHint}" Margin="0,4,0,0" />
                                <Grid Margin="0,10,0,0">
                                    <TextBlock Text="Deprem alarmı" Style="{StaticResource RowHint}" />
                                    <TextBlock Text="{Binding EarthquakeStatusText}" HorizontalAlignment="Right" Style="{StaticResource RowValue}" />
                                </Grid>
                                <Grid Margin="0,10,0,0">
                                    <TextBlock Text="Bağlantı" Style="{StaticResource RowHint}" />
                                    <TextBlock Text="{Binding SelectedConnectionState}" HorizontalAlignment="Right" Style="{StaticResource RowValue}" />
                                </Grid>
                                <TextBlock Text="{Binding ScheduleConflictText}" Style="{StaticResource RowHint}" Margin="0,10,0,0"
                                           Foreground="#FFC400" TextWrapping="Wrap"
                                           Visibility="{Binding HasScheduleConflict, Converter={StaticResource BoolVisibility}}" />
                            </StackPanel>
                        </ui:Card>

                        <ui:Card Grid.Row="1" Padding="24" VerticalAlignment="Stretch" VerticalContentAlignment="Stretch">
                            <StackPanel>
                                <TextBlock Text="Hızlı erişim" Style="{StaticResource RowLabel}" />
                                <TextBlock Text="Sık kullanılan sayfalara tek dokunuşla geçin." Style="{StaticResource RowHint}" Margin="0,4,0,0" />
                                <WrapPanel Margin="0,14,0,0">
                                    <ui:Button Appearance="Secondary" Margin="0,0,8,8" Content="Zamanlayıcı" Command="{Binding NavigateToPageCommand}" CommandParameter="Schedules" />
                                    <ui:Button Appearance="Secondary" Margin="0,0,8,8" Content="Efektler" Command="{Binding NavigateToPageCommand}" CommandParameter="Effects" />
                                    <ui:Button Appearance="Secondary" Margin="0,0,8,8" Content="Profiller" Command="{Binding NavigateToPageCommand}" CommandParameter="Profiles" />
                                    <ui:Button Appearance="Secondary" Margin="0,0,8,8" Content="Bildirimler" Command="{Binding NavigateToPageCommand}" CommandParameter="Notifications" />
                                    <ui:Button Appearance="Secondary" Margin="0,0,8,8" Content="Ortam" Command="{Binding NavigateToPageCommand}" CommandParameter="Environment" />
                                    <ui:Button Appearance="Secondary" Margin="0,0,8,8" Content="Tanılama" Command="{Binding NavigateToPageCommand}" CommandParameter="Diagnostics" />
                                </WrapPanel>
                                <Border Height="1" Margin="0,10,0,14" Background="{DynamicResource ControlStrokeColorDefaultBrush}" />
                                <TextBlock Text="Son bildirim" Style="{StaticResource RowHint}" />
                                <TextBlock Text="{Binding LastNotificationText}" FontSize="13" Margin="0,6,0,0" TextWrapping="Wrap"
                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                            </StackPanel>
                        </ui:Card>
                    </Grid>
                </Grid>

                <Grid Visibility="{Binding IsDiagnosticsPage, Converter={StaticResource BoolVisibility}}">
                    <Grid.RenderTransform>
                        <TranslateTransform />
                    </Grid.RenderTransform>
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Style.Triggers>
                                <Trigger Property="Visibility" Value="Visible">
                                    <Trigger.EnterActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.25" />
                                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" From="12" To="0" Duration="0:0:0.3">
                                                    <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.EnterActions>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="0.95*" />
                        <ColumnDefinition Width="1.25*" />
                    </Grid.ColumnDefinitions>

                    <ui:Card Grid.Column="0" Margin="0,0,14,0" Padding="24" VerticalAlignment="Stretch" VerticalContentAlignment="Stretch">
                        <StackPanel>
                            <TextBlock Text="Bağlantı sınaması" Style="{StaticResource RowLabel}" />
                            <TextBlock Text="{Binding DiagnosticsStatusText}" Style="{StaticResource RowHint}" Margin="0,4,0,0" TextWrapping="Wrap" />
                            <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                <ui:Button Appearance="Primary" Content="Tanılamayı çalıştır" Command="{Binding RunDiagnosticsCommand}" />
                                <ui:Button Appearance="Secondary" Margin="8,0,0,0" Content="Bluetooth ayarları" Command="{Binding OpenBluetoothSettingsCommand}" />
                            </StackPanel>
                            <ItemsControl ItemsSource="{Binding DiagnosticChecks}" Margin="0,16,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="8" Padding="12" Margin="0,0,0,8"
                                                Background="{DynamicResource ControlFillColorDefaultBrush}"
                                                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Glyph}" Foreground="{Binding GlyphBrush}" FontSize="15" Margin="0,0,10,0" VerticalAlignment="Center" />
                                                <StackPanel Grid.Column="1">
                                                    <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold"
                                                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                                    <TextBlock Text="{Binding Result}" Style="{StaticResource RowHint}" Margin="0,3,0,0" TextWrapping="Wrap" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ui:Card>

                    <ui:Card Grid.Column="1" Padding="20" VerticalAlignment="Stretch" VerticalContentAlignment="Stretch">
                        <DockPanel>
                            <Grid DockPanel.Dock="Top">
                                <TextBlock Text="Çalışma günlüğü" Style="{StaticResource RowLabel}" VerticalAlignment="Center" />
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <ComboBox Width="96" SelectedItem="{Binding DiagnosticLogFilter, Mode=TwoWay}" ItemsSource="{Binding DiagnosticLogFilters}" />
                                    <ui:Button Appearance="Secondary" Margin="8,0,0,0" Content="Yenile" Command="{Binding RefreshDiagnosticsLogCommand}" />
                                    <ui:Button Appearance="Secondary" Margin="8,0,0,0" Content="Klasör" Command="{Binding OpenLogFolderCommand}" />
                                </StackPanel>
                            </Grid>
                            <TextBlock DockPanel.Dock="Bottom" Text="{Binding DiagnosticsLogPath}" Style="{StaticResource RowHint}" Margin="0,8,0,0" TextTrimming="CharacterEllipsis" />
                            <ListBox ItemsSource="{Binding DiagnosticLogLines}" Margin="0,12,0,0" Background="Transparent" BorderThickness="0"
                                     FontFamily="Cascadia Mono, Consolas" FontSize="11"
                                     ScrollViewer.HorizontalScrollBarVisibility="Auto" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        </DockPanel>
                    </ui:Card>
                </Grid>

                <Grid Visibility="{Binding IsControlPage, Converter={StaticResource BoolVisibility}}">
                    <Grid.RenderTransform>
                        <TranslateTransform />
                    </Grid.RenderTransform>
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Style.Triggers>
                                <Trigger Property="Visibility" Value="Visible">
                                    <Trigger.EnterActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.25" />
                                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" From="12" To="0" Duration="0:0:0.3">
                                                    <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.EnterActions>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Height="180" Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="290" />
                        </Grid.ColumnDefinitions>
                    <ui:Card Grid.Column="0" Padding="22" Margin="0,0,16,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Border Width="42" Height="42" CornerRadius="10" Background="{DynamicResource ControlFillColorDefaultBrush}">
                                <Path Data="{StaticResource BulbGlassGeometry}" Width="18" Height="21" Stretch="Uniform"
                                      Fill="{StaticResource BulbFill}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0,12,0">
                                <TextBlock Text="{Binding SelectedDevice.DisplayName, TargetNullValue=Henüz ampul seçilmedi}" FontSize="15" FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                <TextBlock Text="Philips Hue ampulü" FontSize="11" Margin="0,3,0,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            </StackPanel>

                            <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,22,0,0">
                                <Border CornerRadius="12" Padding="10,5" Margin="0,0,10,0" VerticalAlignment="Center"
                                        Background="{DynamicResource ControlFillColorDefaultBrush}">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="{DynamicResource ControlFillColorDefaultBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsLightOn}" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="{Binding SelectedPowerState}" FontSize="11" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                </Border>

                                <ui:Button Appearance="Primary" Content="Bağlan" Command="{Binding ConnectSelectedCommand}"
                                           Visibility="{Binding IsSelectedDeviceConnected, Converter={StaticResource NotBoolVisibility}}" />
                                <ui:Button Appearance="Secondary" Content="Bağlantıyı kes" Command="{Binding DisconnectSelectedCommand}"
                                           Visibility="{Binding IsSelectedDeviceConnected, Converter={StaticResource BoolVisibility}}" />
                                <ui:Button Appearance="Secondary" Margin="8,0,0,0" Content="Yanıp söndür" Command="{Binding IdentifyCommand}"
                                           Visibility="{Binding IsSelectedDeviceConnected, Converter={StaticResource BoolVisibility}}" />
                                <ui:ProgressRing IsIndeterminate="True" Width="20" Height="20" Margin="12,0,0,0" VerticalAlignment="Center"
                                                 Visibility="{Binding IsConnecting, Converter={StaticResource BoolVisibility}}" />
                            </StackPanel>
                        </Grid>
                    </ui:Card>
                    <controls:ArtworkStage Grid.Column="1" Page="Control" />
                    </Grid>

                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.08*" />
                            <ColumnDefinition Width="0.92*" />
                        </Grid.ColumnDefinitions>

                        <ui:Card Grid.Column="0" Margin="0,0,14,0" Padding="18">
                            <StackPanel>
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Setter Property="Opacity" Value="1" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsSelectedDeviceConnected}" Value="False">
                                                    <Setter Property="Opacity" Value="0.45" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>

                                    <StackPanel IsEnabled="{Binding IsSelectedDeviceConnected}">
                                        <Grid>
                                            <StackPanel>
                                                <TextBlock Text="Güç" Style="{StaticResource RowLabel}" />
                                                <TextBlock Text="Ampulü açıp kapatın" Style="{StaticResource RowHint}" Margin="0,3,0,0" />
                                            </StackPanel>
                                            <ui:ToggleSwitch HorizontalAlignment="Right" VerticalAlignment="Center"
                                                             IsChecked="{Binding IsLightOn, Mode=TwoWay}"
                                                             OnContent="Açık" OffContent="Kapalı" />
                                        </Grid>

                                        <Border Height="1" Margin="0,10,0,10" Background="{DynamicResource ControlStrokeColorDefaultBrush}" />

                                        <Grid>
                                            <TextBlock Text="Parlaklık" Style="{StaticResource RowLabel}" />
                                        </Grid>
                                        <Grid Margin="0,2,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Slider Style="{StaticResource FluentSlider}" Minimum="1" Maximum="100" SmallChange="1" LargeChange="10"
                                                    Value="{Binding BrightnessPercent, Mode=TwoWay}" />
                                            <ui:TextBox Grid.Column="1" Width="76" Margin="12,0,0,0" TextAlignment="Center"
                                                        Text="{Binding BrightnessPercent, Mode=TwoWay, UpdateSourceTrigger=LostFocus, StringFormat={}{0:0}}" />
                                        </Grid>

                                        <Border Height="1" Margin="0,8,0,8" Background="{DynamicResource ControlStrokeColorDefaultBrush}" />

                                        <Grid>
                                            <TextBlock Text="Işık sıcaklığı" Style="{StaticResource RowLabel}" />
                                        </Grid>
                                        <Grid Margin="0,2,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Slider Style="{StaticResource TemperatureSlider}" Minimum="154" Maximum="455" IsDirectionReversed="True"
                                                    SmallChange="5" LargeChange="25"
                                                    Value="{Binding ColorTemperatureMired, Mode=TwoWay}" />
                                            <ui:TextBox Grid.Column="1" Width="76" Margin="12,0,0,0" TextAlignment="Center"
                                                        Text="{Binding ColorTemperatureMired, Mode=TwoWay, UpdateSourceTrigger=LostFocus, StringFormat={}{0:0}}" />
                                        </Grid>
                                        <Grid Margin="0,2,0,0">
                                            <TextBlock Text="Sıcak · 2200 K" Style="{StaticResource RowHint}" HorizontalAlignment="Left" />
                                            <TextBlock Text="Soğuk · 6500 K" Style="{StaticResource RowHint}" HorizontalAlignment="Right" />
                                        </Grid>

                                        <Border Height="1" Margin="0,8,0,8" Background="{DynamicResource ControlStrokeColorDefaultBrush}" />

                                        <Grid>
                                            <TextBlock Text="Renk" Style="{StaticResource RowLabel}" />
                                            <TextBlock Text="{Binding LightModeLabel}" HorizontalAlignment="Right" Style="{StaticResource RowValue}" />
                                        </Grid>
                                        <Grid Margin="0,8,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Width="140" Height="140" CornerRadius="70" Padding="7"
                                                    Background="#15212D" BorderBrush="#54FFFFFF" BorderThickness="1">
                                                <controls:ColorWheel Width="124" Height="124"
                                                                     SelectedColor="{Binding WheelColor, Mode=OneWay}"
                                                                     ColorChanged="OnWheelColorChanged" />
                                            </Border>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="18,0,0,0">
                                                <TextBlock Text="Renk stüdyosu" FontSize="13" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                                <TextBlock Text="Tekerlek üzerinde sürükleyerek tonu ve doygunluğu seçin."
                                                           Style="{StaticResource RowHint}" Margin="0,5,0,0" TextWrapping="Wrap" />
                                                <Border Width="64" Height="40" CornerRadius="12" Margin="0,10,0,0" HorizontalAlignment="Left"
                                                        Background="{Binding WheelColor}" BorderBrush="#66FFFFFF" BorderThickness="1" />
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>

                                    <StackPanel Visibility="{Binding HasSelectedDevice, Converter={StaticResource NotBoolVisibility}}" HorizontalAlignment="Center" Margin="0,40,0,0" MaxWidth="300">
                                        <Border Width="72" Height="72" CornerRadius="20" Background="{DynamicResource ControlFillColorDefaultBrush}" HorizontalAlignment="Center">
                                            <Path Data="{StaticResource BulbGlassGeometry}" Width="30" Height="35" Stretch="Uniform"
                                                  Fill="{StaticResource BulbFill}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <TextBlock Text="Henüz ampul eklenmedi" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,16,0,0"
                                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                        <TextBlock Text="Ampulünüzü açın, bilgisayarınıza yakın tutun ve aramayı başlatın."
                                                   FontSize="12" TextWrapping="Wrap" TextAlignment="Center" Margin="0,8,0,0" LineHeight="18"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                        <ui:Button Appearance="Primary" Margin="0,18,0,0" HorizontalAlignment="Center" Content="Ampul ara" Command="{Binding StartScanCommand}" />
                                        <TextBlock Text="{Binding ScanStatus}" FontSize="11" HorizontalAlignment="Center" Margin="0,10,0,0"
                                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                    </StackPanel>
                                </StackPanel>
                        </ui:Card>

                        <ui:Card Grid.Column="1" Margin="14,0,0,0" Padding="0">
                            <Grid ClipToBounds="True">
                                <controls:BulbPreview Width="320" Height="360" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                      PreviewColor="{Binding WheelColor}" Brightness="{Binding BrightnessPercent}" IsOn="{Binding IsLightOn}"
                                                      IsColorMode="{Binding IsColorMode}" ColorTemperature="{Binding ColorTemperatureMired}"
                                                      EditableBrightness="{Binding BrightnessPercent}" EditableTemperature="{Binding ColorTemperatureMired}"
                                                      IsEditable="{Binding IsSelectedDeviceConnected}"
                                                      Margin="8,0,8,36" />

                                <StackPanel VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,24">
                                    <TextBlock Text="{Binding SelectedDevice.DisplayName, TargetNullValue=LUMEN}" HorizontalAlignment="Center"
                                               FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                    <TextBlock Text="{Binding LightModeLabel}" HorizontalAlignment="Center" FontSize="11" Margin="0,4,0,0"
                                               Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                    <TextBlock Text="İpucu: ampul üzerinde sürükleyin — dikey parlaklık, yatay ışık sıcaklığı"
                                               HorizontalAlignment="Center" FontSize="10" Margin="0,6,0,0"
                                               Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                </StackPanel>
                            </Grid>
                        </ui:Card>
                    </Grid>
                </Grid>

                <Grid Visibility="{Binding IsEffectsPage, Converter={StaticResource BoolVisibility}}">
                    <Grid.RenderTransform>
                        <TranslateTransform />
                    </Grid.RenderTransform>
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Style.Triggers>
                                <Trigger Property="Visibility" Value="Visible">
                                    <Trigger.EnterActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.25" />
                                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" From="12" To="0" Duration="0:0:0.3">
                                                    <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.EnterActions>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="0.9*" />
                        <ColumnDefinition Width="1.2*" />
                        <ColumnDefinition Width="0.9*" />
                    </Grid.ColumnDefinitions>

                    <ui:Card Grid.Column="0" Margin="0,0,14,0" Padding="24" VerticalAlignment="Stretch" VerticalContentAlignment="Stretch">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <StackPanel Grid.Row="0">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Opacity" Value="1" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsSelectedDeviceConnected}" Value="False">
                                                <Setter Property="Opacity" Value="0.45" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <StackPanel IsEnabled="{Binding IsSelectedDeviceConnected}">
                                    <Grid>
                                        <TextBlock Text="Efekt seçimi" Style="{StaticResource RowLabel}" />
                                        <TextBlock Text="{Binding ActiveEffectName}" HorizontalAlignment="Right" Style="{StaticResource RowValue}" />
                                    </Grid>
                                    <ItemsControl ItemsSource="{Binding Effects}" Margin="0,14,0,0">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button Style="{StaticResource EffectChipActive}"
                                                        Command="{Binding DataContext.ToggleEffectCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}">
                                                    <StackPanel Orientation="Horizontal">
                                                        <ToggleButton Style="{StaticResource FavoriteStar}" IsChecked="{Binding IsFavorite, Mode=OneWay}"
                                                                      Command="{Binding DataContext.ToggleEffectFavoriteCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                      CommandParameter="{Binding}" />
                                                        <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                                                    </StackPanel>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock Text="Bir efekte dokununca başlar, tekrar dokununca durur. Efektler ampulün içinde çalışır; bilgisayar kapalıyken de sürer."
                                               Style="{StaticResource RowHint}" Margin="0,6,0,0" TextWrapping="Wrap" />
                                </StackPanel>
                            </StackPanel>
                            <controls:ArtworkStage Grid.Row="1" Page="Effects" Margin="0,16,0,0" MinHeight="160" />
                        </Grid>
                    </ui:Card>

                    <ui:Card Grid.Column="1" Padding="16" VerticalAlignment="Stretch" VerticalContentAlignment="Stretch">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <controls:EffectPreview Grid.Row="0" MinHeight="320" EffectKind="{Binding PreviewEffect}" Speed="{Binding EffectSpeed}" />
                            <StackPanel Grid.Row="1" Margin="0,14,0,6" HorizontalAlignment="Center">
                                <TextBlock Text="{Binding ActiveEffectName}" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center"
                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                <TextBlock Text="Canlı önizleme · hız kaydırıcısı animasyonu da hızlandırır" Style="{StaticResource RowHint}"
                                           Margin="0,4,0,0" HorizontalAlignment="Center" />
                            </StackPanel>
                        </Grid>
                    </ui:Card>

                    <ui:Card Grid.Column="2" Margin="14,0,0,0" Padding="24" VerticalAlignment="Stretch" VerticalContentAlignment="Stretch">
                        <StackPanel>
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
