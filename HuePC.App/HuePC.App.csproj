<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.22000.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.22000.0</SupportedOSPlatformVersion>
    <WindowsSdkPackageVersion>10.0.19041.57</WindowsSdkPackageVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationIcon>Assets\lumen.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\lumen-servo-skull.png" />
    <Resource Include="Assets\lumen-servo-skull-splash.png" />
    <Resource Include="Assets\lumen.ico" />
    <Resource Include="Assets\Illustrations\*.png" />
    <Resource Include="Assets\Fonts\*.ttf" />
    <!-- WinForms adds System.Drawing/System.Windows.Forms globals that clash with WPF types. -->
    <Using Remove="System.Drawing" />
    <Using Remove="System.Windows.Forms" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="WPF-UI" Version="4.3.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\HuePC.Core\HuePC.Core.csproj" />
    <ProjectReference Include="..\HuePC.Bluetooth\HuePC.Bluetooth.csproj" />
    <ProjectReference Include="..\HuePC.Audio\HuePC.Audio.csproj" />
    <ProjectReference Include="..\HuePC.Infrastructure\HuePC.Infrastructure.csproj" />
    <ProjectReference Include="..\HuePC.Notifications\HuePC.Notifications.csproj" />
    <ProjectReference Include="..\HuePC.System\HuePC.System.csproj" />
  </ItemGroup>

</Project>
